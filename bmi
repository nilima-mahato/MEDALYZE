    <script>
        let currentUnit = 'metric';

        function setUnits(unit) {
            currentUnit = unit;
            const metricBtn = document.getElementById('metric-btn');
            const imperialBtn = document.getElementById('imperial-btn');
            const heightInput = document.getElementById('height');
            const weightInput = document.getElementById('weight');

            if (unit === 'metric') {
                metricBtn.classList.add('active');
                imperialBtn.classList.remove('active');
                heightInput.placeholder = 'Enter height in cm';
                weightInput.placeholder = 'Enter weight in kg';
            } else {
                imperialBtn.classList.add('active');
                metricBtn.classList.remove('active');
                heightInput.placeholder = 'Enter height in inches';
                weightInput.placeholder = 'Enter weight in lbs';
            }

            // Clear previous results
            document.getElementById('result').classList.remove('show');
            document.getElementById('error').textContent = '';
        }

        function calculateBMI(weight, height, unit) {
            let bmi;
            
            if (unit === 'metric') {
                // BMI = weight(kg) / height(m)²
                const heightInMeters = height / 100;
                bmi = weight / (heightInMeters * heightInMeters);
            } else {
                // BMI = (weight(lbs) / height(inches)²) × 703
                bmi = (weight / (height * height)) * 703;
            }
            
            return parseFloat(bmi.toFixed(1));
        }

        function getBMICategory(bmi) {
            if (bmi < 18.5) {
                return {
                    category: 'Underweight',
                    description: 'Your BMI indicates you may be underweight. Consider consulting with a healthcare provider.',
                    color: '#74b9ff'
                };
            } else if (bmi >= 18.5 && bmi < 25) {
                return {
                    category: 'Normal Weight',
                    description: 'Your BMI indicates a healthy weight range. Keep up the good work!',
                    color: '#00b894'
                };
            } else if (bmi >= 25 && bmi < 30) {
                return {
                    category: 'Overweight',
                    description: 'Your BMI indicates you may be overweight. Consider a balanced diet and regular exercise.',
                    color: '#fdcb6e'
                };
            } else {
                return {
                    category: 'Obese',
                    description: 'Your BMI indicates obesity. Consider consulting with a healthcare provider for guidance.',
                    color: '#e17055'
                };
            }
        }

        document.getElementById('bmi-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const height = parseFloat(document.getElementById('height').value);
            const weight = parseFloat(document.getElementById('weight').value);
            const errorDiv = document.getElementById('error');
            
            // Clear previous error
            errorDiv.textContent = '';
            
            // Validation
            if (!height || !weight || height <= 0 || weight <= 0) {
                errorDiv.textContent = 'Please enter valid height and weight values.';
                return;
            }
            
            // Additional validation based on units
            if (currentUnit === 'metric') {
                if (height < 50 || height > 300) {
                    errorDiv.textContent = 'Height should be between 50-300 cm.';
                    return;
                }
                if (weight < 10 || weight > 500) {
                    errorDiv.textContent = 'Weight should be between 10-500 kg.';
                    return;
                }
            } else {
                if (height < 20 || height > 120) {
                    errorDiv.textContent = 'Height should be between 20-120 inches.';
                    return;
                }
                if (weight < 20 || weight > 1100) {
                    errorDiv.textContent = 'Weight should be between 20-1100 lbs.';
                    return;
                }
            }
            
            const bmi = calculateBMI(weight, height, currentUnit);
            const categoryInfo = getBMICategory(bmi);
            
            // Display results
            document.getElementById('bmi-value').textContent = bmi;
            document.getElementById('bmi-value').style.color = categoryInfo.color;
            document.getElementById('bmi-category').textContent = categoryInfo.category;
            document.getElementById('bmi-description').textContent = categoryInfo.description;
            document.getElementById('result').classList.add('show');
        });

        // Allow Enter key to calculate
        document.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('bmi-form').dispatchEvent(new Event('submit'));
            }
        });
    </script>
